# Copy to .env for local dev. See DEPLOYMENT.md for production (Railway) values.

# Postgres connection string. For local dev via `npm run db:up` (embedded-postgres),
# this matches scripts/dev-db.js's defaults - don't change the port/user/db name
# unless you also change them there.
DATABASE_URL="postgresql://casino:casino@127.0.0.1:54329/casino_poc?schema=public"

# Secret used to sign/verify JWTs. Generate a real random value for anything
# beyond local dev, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-change-me"

# JWT lifetime (jsonwebtoken "expiresIn" format).
JWT_EXPIRES_IN="7d"

# Port the Express server listens on.
PORT=8787

# Comma-separated list of origins allowed by CORS (the Vite client's dev origin
# by default). Set to your deployed client origin(s) in production.
CORS_ORIGIN="http://localhost:3000"
