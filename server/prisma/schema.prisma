// Prisma schema for casino-poc's server-authoritative backend.
//
// Mirrors the client's economy shapes (src/economy/*.ts) - see that code and
// repo-root CLAUDE.md for the current "arcade token" economy rules:
//   - GC (spend to play) and TICKETS (won from playing, spent in the Item
//     Shop) are separate ledgers (balances.gold_coins / balances.tickets)
//   - every balance change is one row in `transactions` (currency/type mirror
//     ledger.ts's Currency/TransactionType unions) - nothing else may write
//     gold_coins/tickets
//   - skins are TICKETS-only and structurally separate from GC
//
// History: this used to be a GC/SC ("Sweeps Coin") sweepstakes-style model
// with a 1x playthrough requirement and real-money SC redemption
// (playthrough_progress table, REDEMPTION_SC/SIGNUP_BONUS_SC/etc.
// transaction types, MIN_SC_REDEMPTION). That model is retired - see the
// Currency/TransactionType enums and PlaythroughProgress model below for
// what's kept around unused rather than destructively migrated away (same
// philosophy as the ROUND_REFUND_GC/SC values already had: additive-only
// schema changes, no enum-value removal or table drops for a pure
// after-the-fact cleanup with no functional benefit). The `Balance.tickets`
// field is intentionally still mapped to the physical `stake_coins` column
// for the same reason - only the Prisma-side name changed, not the
// database - the numeric value carries over as-is, same "no meaningful
// mapping better than a direct carry-over for existing data" call made on
// the client (see GameState.ts's migrateLegacyProfile doc comment).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?
  passwordHash String   @map("password_hash")
  // Explicit timestamptz - Prisma's default DateTime mapping on Postgres is
  // `timestamp(3)` (timezone-naive), which silently reinterprets stored UTC
  // instants through the DB session's local timezone on comparison/read-back
  // (embedded-postgres defaults to the host's local zone). Bit the
  // attendant-claim cooldown badly in testing (see AttendantClaim below) -
  // every DateTime column here uses @db.Timestamptz(3) to avoid it.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // Retention Leg 1: set on every successful signup AND login (see
  // routes/auth.ts). Nullable rather than defaulting to now() so pre-
  // existing rows stay honestly "unknown" instead of being backfilled with
  // a fake login instant the moment the migration runs - a null here means
  // "hasn't signed in since tracking shipped", which is a real, useful
  // distinction for any day-1/day-7 retention query.
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  balance             Balance?
  transactions        Transaction[]
  skinsOwned          SkinOwned[]
  equippedSkin        EquippedSkin?
  itemsOwned          ItemOwned[]
  equippedItems       EquippedItem[]
  lastPosition        LastPosition?
  events              Event[]
  playthroughProgress PlaythroughProgress?
  attendantClaim      AttendantClaim?
  adRewardClaim       AdRewardClaim?
  gameRounds          GameRound[]

  @@map("users")
}

// One row per user. Two independent balances - never conflated, never
// mutated directly outside the ledger core (see src/economy/ledger.ts on
// the server, which is the only code allowed to touch these two columns).
// `tickets` is intentionally still mapped to the old `stake_coins` physical
// column - see this file's header comment.
model Balance {
  userId    String @id @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goldCoins Int    @default(0) @map("gold_coins")
  tickets   Int    @default(0) @map("stake_coins")

  @@map("balances")
}

enum Currency {
  GC
  TICKETS
  // Retired (see this file's header comment) - kept, unused, rather than a
  // destructive enum-type recreation.
  SC
}

// Closed set of transaction types, mirroring ledger.ts's TransactionType
// union on the client 1:1 so the audit trail is comparable and QA can grep
// for a type to find every code path that can move money.
enum TransactionType {
  SIGNUP_BONUS_GC
  PACKAGE_GC
  AD_REWARD_GC
  WAGER_GC
  ADJUST_GC
  // The only way TICKETS are ever credited - a game round's win.
  GAME_WIN_TICKETS
  // The only way TICKETS are ever debited - an Item Shop purchase.
  SKIN_PURCHASE_TICKETS
  // A GC payout - NOT retired, still used by Triple Chance
  // (routes/games.ts), which is GC-in/GC-out (double-or-nothing on GC just
  // received from the Coin Kiosk), not one of the 14 GC-wager/TICKETS-
  // payout games that go through GAME_WIN_TICKETS instead.
  PAYOUT_GC
  // Retired (see this file's header comment) - the old GC/SC sweepstakes
  // model's SC-side transaction types, kept unused rather than a
  // destructive enum-type recreation.
  SIGNUP_BONUS_SC
  PACKAGE_BONUS_SC
  SKIN_PURCHASE_GC
  REDEMPTION_SC
  WAGER_SC
  PAYOUT_SC
  ADJUST_SC
  // UNUSED - reserved, do not wire up without fresh sign-off. Added for a
  // proposed #42 follow-up (auto-refund an abandoned round's wager if
  // discovered still active at next login, instead of always forfeiting)
  // that was reversed before any route/code referenced these: a login-
  // triggered refund is exploitable regardless of how the "was this really
  // an accidental disconnect" signal is computed server-side, because a
  // player can just deliberately manufacture that exact signal (log out on
  // a board they don't like instead of clicking walk away, then log back
  // in) to always get a refund instead of ever accepting a forfeit -
  // defeating the point of forfeiting at all. Decision: POST /games/abandon
  // stays always-forfeit, no exceptions (see that route in routes/games.ts).
  // Left as unused enum values rather than doing a destructive enum-type
  // recreation to remove them, since nothing has ever written a transaction
  // with these types - genuinely inert, not a behavior difference.
  ROUND_REFUND_GC
  ROUND_REFUND_SC
}

// Append-only. EVERY balance change must insert exactly one of these in the
// same DB transaction as the balance update - see src/economy/ledger.ts.
model Transaction {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency     Currency
  type         TransactionType
  amount       Int
  balanceAfter Int             @map("balance_after")
  meta         Json?
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("transactions")
}

model SkinOwned {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinId String @map("skin_id")

  @@id([userId, skinId])
  @@map("skins_owned")
}

// One equipped skin per user - PK on userId enforces that directly.
model EquippedSkin {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinId String @map("skin_id")

  @@map("equipped_skin")
}

// Cosmetic equip-slot categories beyond skins (see server/src/itemCatalog.ts
// and economy/itemShop.ts) - a floating emoji badge worn above the head
// (ACCESSORY) and a small companion sprite that follows the player around
// the Overworld (PET). Both are TICKETS-only, same economy rule as skins
// (repo-root CLAUDE.md) - structurally separate tables from SkinOwned/
// EquippedSkin rather than folding into them, since unlike a skin (always
// exactly one equipped, defaulting to "player") these can be equipped OR
// NOT - "wearing nothing" is a valid, common state for both.
enum ItemCategory {
  ACCESSORY
  PET
}

// Mirrors SkinOwned's shape exactly, generalized to any non-skin category.
model ItemOwned {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId String @map("item_id")

  @@id([userId, itemId])
  @@map("items_owned")
}

// One row per (user, category) - not per user like EquippedSkin, since a
// user can have an accessory AND a pet equipped simultaneously (independent
// slots). Absence of a row for a category means "nothing equipped there",
// unlike EquippedSkin which always has an implicit "player" default.
model EquippedItem {
  userId   String       @map("user_id")
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ItemCategory
  itemId   String       @map("item_id")

  @@id([userId, category])
  @@map("equipped_items")
}

model LastPosition {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  x      Float
  y      Float

  @@map("last_position")
}

// RETIRED - the playthrough/redemption model this backed no longer exists
// (see this file's header comment). Left in place, unused, rather than a
// destructive table drop.
model PlaythroughProgress {
  userId    String @id @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scRequired Int   @default(0) @map("sc_required")
  scWagered  Int   @default(0) @map("sc_wagered")

  @@map("playthrough_progress")
}

// Server-enforced version of the client's persisted attendantClaimedAt -
// see src/economy/attendantClaim.ts. One row per user; null/absent means
// "never claimed". last_claimed_at MUST be timestamptz (see User.createdAt's
// comment) - the 30s cooldown check compares it against `now() - 30s` in raw
// SQL, and a timezone-naive column made that comparison silently wrong by
// whatever offset the DB session's local timezone happened to be.
model AttendantClaim {
  userId        String    @id @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastClaimedAt DateTime? @map("last_claimed_at") @db.Timestamptz(3)

  @@map("attendant_claim")
}

// Ad-reward GC refill cooldown (see economy/adRewards.ts) - separate table
// from AttendantClaim since these are two independently-cooled-down claim
// sources, not the same mechanic. Same @db.Timestamptz(3) note as above
// applies here too.
model AdRewardClaim {
  userId        String    @id @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastClaimedAt DateTime? @map("last_claimed_at") @db.Timestamptz(3)

  @@map("ad_reward_claim")
}

// #36: server-authoritative round state for multi-step games (Mines, Dragon
// Tower, Hi-Lo, Blackjack, Video Poker - anything that isn't a single
// bet-in/resolve-out request). Single-shot games (Slots, Roulette, CoinFlip,
// Dice, Limbo, Plinko, Keno, Wheel, Baccarat) don't use this table at all -
// their whole round happens inside one request/response and the existing
// `transactions.meta` JSON is their audit trail.
//
// `state` holds whatever hidden data that specific game needs to keep
// server-side between requests (mine positions, the undealt portion of a
// deck, the dealer's hole card, etc.) - shape is game-specific and defined
// per-game server-side (see server/src/games/<name>.ts), never typed at the
// schema level since every game's shape differs. The public (client-safe)
// slice of it is computed fresh per response - `state` itself is never sent
// to the client wholesale.
//
// Exactly one *active* round per user is enforced at the application layer
// (the `start` handler for each game checks-then-creates inside the same
// transaction) rather than a DB constraint, since "active" is a status
// value rather than something a unique index can express cleanly here.
model GameRound {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      String
  status    String   @default("active")
  betAmount Int      @map("bet_amount")
  currency  Currency
  state     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, game, status])
  @@map("game_rounds")
}

// Retention Leg 1: self-hosted player-activity events. Deliberately OUR
// OWN table rather than a third-party analytics SDK (PostHog/Mixpanel/
// Amplitude/Segment) - founder's call, so player data never leaves this
// database. Nothing here is on any gameplay or money critical path: this
// table is append-only telemetry, read by hand for retention questions
// ("how many of last week's signups came back on day 7", "which games do
// people actually open"), and losing a row costs nothing.
//
// PRIVACY (this is a compliance-phase social-casino product - keep it that
// way): rows must never carry a password, a token, an email, an IP
// address, or free text a player typed. `props` is for small, bounded,
// enum-ish facts about the event only - a game name, a bet amount, a
// win/lose outcome, a catalog item id. The route validates that shape (see
// routes/events.ts's PropValue) rather than trusting callers, and the
// client helper (src/api/track.ts) only ever passes literals it constructs
// itself.
//
// Why not just derive all of this from `transactions`? The ledger only
// sees money moving. Most retention signal doesn't move money - opening a
// game and backing out, logging in and idling, browsing the Item Shop
// without buying - and none of it exists in any table today. Retention
// data can't be reconstructed after the fact, which is why this ships
// first.
model Event {
  id String @id @default(uuid())

  // Nullable ON PURPOSE: pre-login activity (app boot, the login screen
  // itself) is exactly the funnel data we care most about, and it has no
  // user yet. NEVER populated from the request body - the route derives it
  // solely from a verified JWT (see routes/events.ts).
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dot-namespaced event name, e.g. "session.start", "game.opened",
  // "game.round_played". Kept a plain String rather than an enum so adding
  // an event never needs a destructive enum migration - the closed set
  // lives in src/api/track.ts on the client instead.
  name String

  // Event-specific properties. See the PRIVACY note above for what may go
  // in here. Optional - plenty of events are just "this happened".
  props Json?

  // Opaque, client-generated, per-app-load random id (see src/api/track.ts).
  // Lets pre-login and post-login events from the same visit be stitched
  // into one session without needing a user id. Not a JWT, not a cookie,
  // not derived from anything identifying, and not stable across reloads.
  sessionId String @map("session_id")

  // When the SERVER received the batch. Deliberately server-assigned
  // rather than accepting a client clock - device clocks are wrong often
  // enough to wreck a date-range query, and a client-supplied timestamp is
  // trivially forgeable. Batching delay is bounded by the client flush
  // interval (seconds), which is well inside the tolerance of any
  // retention question this table exists to answer.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // "Everything user X did, in order" - the per-player timeline.
  @@index([userId, createdAt])
  // "Every event of type Y between two dates" - the funnel/retention
  // rollups. Name first so the range scan happens inside one event type.
  @@index([name, createdAt])
  // "Everything that happened in one visit", for reading a single session
  // end to end when debugging a funnel drop-off.
  @@index([sessionId, createdAt])
  @@map("events")
}
